# Modelo de configuração do serviço. Preencha os valores no Render, nunca no Git.
ADA_DEPLOYMENT_MODE=private_cloud
ADA_REQUIRE_LOGIN=false
ADA_PUBLIC_ORIGIN=https://SEU-SERVICO.onrender.com
ADA_OAUTH_CALLBACK_BASE=https://SEU-SERVICO.onrender.com
ADA_ACCESS_USER=ada
ADA_ACCESS_PASSWORD=
ADA_DATABASE_BACKEND=postgres
ADA_DATABASE_SCHEMA=ada
SUPABASE_DATABASE_URL=
SUPABASE_DB_CA_CERT=/etc/secrets/prod-ca-2021.crt
ADA_MODEL_PROVIDER=claude_agent_sdk
MODEL_NAME=
ADA_LIGHT_MODEL=
MODEL_API_KEY=
ADA_SDK_MAX_BUDGET_USD=0.25
ADA_SDK_ORCHESTRATION=native
ADA_SDK_TASK_MAX_TURNS=48
ADA_SDK_TASK_MAX_TOOLS=80
ADA_SDK_TASK_TIMEOUT_SECONDS=900
ADA_TASK_BUDGET_USD=0.50
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
