MODEL_BASE_URL=https://api.anthropic.com/v1
MODEL_NAME=claude-sonnet-5-5
# Modelo opcional para especialistas em tarefas menores. Vazio mantém um modelo só.
# Use um identificador disponível na sua conta Anthropic, ou o alias haiku do SDK.
ADA_LIGHT_MODEL=
MODEL_API_KEY=
# Necessário somente se a chave Anthropic não estiver vinculada a um workspace.
ANTHROPIC_WORKSPACE_ID=

# Cada integração OAuth exige cadastro próprio no serviço correspondente.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ADA_OAUTH_CALLBACK_BASE=http://127.0.0.1:8000
# PostgreSQL opcional; preparar esquema com backend/scripts/prepare_postgres.py.
SUPABASE_DATABASE_URL=
SUPABASE_DB_CA_CERT=

# sqlite (padrão) ou postgres (após preparar o esquema)
ADA_DATABASE_BACKEND=sqlite

# Claude Agent SDK para criação e conversa; use openai_compatible para outros provedores.
ADA_MODEL_PROVIDER=claude_agent_sdk
# Teto por chamada ao SDK (até 1 dólar); criação pode tentar mais de uma chamada.
ADA_SDK_MAX_BUDGET_USD=0.25
ADA_SDK_TIMEOUT_SECONDS=120
# Runtime nativo: plano escolhido durante a execução, sessões e skills por conversa.
# planned mantém o coordenador anterior como fallback explícito.
ADA_SDK_ORCHESTRATION=native
ADA_SDK_TASK_MAX_TURNS=48
ADA_SDK_TASK_MAX_TOOLS=80
ADA_SDK_TASK_TIMEOUT_SECONDS=900

# Orçamento compartilhado por tarefa orquestrada (em dólares; até 5).
ADA_TASK_BUDGET_USD=0.50
# Executor local: docker (padrão) ou multipass (VM Ubuntu descartável).
ADA_SANDBOX_BACKEND=docker
# Executor remoto opcional, cobrado pelo Render. Manter desativado até configurar.
# ADA_SANDBOX_BACKEND=render
ADA_RENDER_SANDBOX_ENABLED=false
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Memória automática (também pode ser desligada por agente na interface)
ADA_MEMORY_AUTOMATIC=true
# Somente para provedor openai_compatible com chave paga; configure os preços reais.
ADA_INPUT_USD_PER_MTOK=0
ADA_OUTPUT_USD_PER_MTOK=0

# Instalação privada hospedada (uma pessoa; consulte docs/DEPLOY_PRIVADO.md).
# ADA_DEPLOYMENT_MODE=private_cloud
# ADA_PUBLIC_ORIGIN=https://seu-servico.onrender.com
# ADA_ACCESS_USER=ada
# ADA_ACCESS_PASSWORD=senha-de-pelo-menos-8-caracteres
